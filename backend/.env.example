# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas (leave empty with USE_IN_MEMORY_DB=true for instant local dev)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/worktrack?retryWrites=true&w=majority
USE_IN_MEMORY_DB=false

# Authentication
JWT_SECRET=replace-with-a-strong-64-char-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=worktrack_token

# Cloudinary (optional in local dev; falls back to local uploads/ when unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP Email (optional in local dev; logs reset links to console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=WorkTrack <no-reply@worktrack.local>

# Production Bootstrap (used once with `npm run bootstrap:prod`)
ORGANIZATION_NAME=WorkTrack
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=ReplaceWithStrongPassword#1
INITIAL_ADMIN_FIRST_NAME=System
INITIAL_ADMIN_LAST_NAME=Administrator
